rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função de checagem para saber se o requisitante tem role 'admin'
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }
    
    // Função para verificar se a conta existe e não foi desativada (usuário ainda consta na base)
    function isRegisteredAndActive() {
    	return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    match /users/{userId} {
      // Criação de perfil restrita: OBRIGATÓRIO que a role seja 'user'
      // Previne "Escalada de Privilégios" se um hacker tentar forçar role='admin'
      allow create: if request.auth != null 
                    && request.auth.uid == userId 
                    && request.resource.data.role == "user";
      // Usuário lê o próprio, Admin lê de todos
      allow read: if request.auth.uid == userId || isAdmin();
      // Apenas Admin pode atualizar (ex: mudar roles) e deletar
      allow update, delete: if isAdmin();
    }

    match /projetos/{projetoId} {
      // Qualquer pessoa (mesmo deslogada) pode ver os projetos (são as postagens no portfólio)
      allow read: if true;
      // Apenas Admin cria, atualiza ou deleta
      allow create, update, delete: if isAdmin();
    }
    
    match /certificados/{certificadoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    match /perguntas/{perguntaId} {
      // Validação Estrita (Backend): Verifica tipo, tamanho máximo (1000 chars) e força status pendente no envio
      allow create: if isRegisteredAndActive()
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 1000
                    && request.resource.data.status == "pendente";
      // Qualquer pessoa pode LER as perguntas na vitrine pública
      allow read: if true;
      allow update: if isAdmin();
      // O autor pode deletar sua própria pergunta se ainda existir, e Admin pode deletar
      allow delete: if (request.auth != null && request.auth.uid == resource.data.uid) || isAdmin();
    }
  }
}
